{
  "name": "core-async",
  "version": "3.0.0",
  "description": "A standalone, zero-dependency JavaScript CSP (Communicating Sequential Processes) library. Channels, transducers, pub/sub, throttle, alts, and more. Works with async/await.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasdao/core-async.git"
  },
  "bugs": {
    "url": "https://github.com/nicolasdao/core-async/issues"
  },
  "homepage": "https://github.com/nicolasdao/core-async#readme",
  "scripts": {
    "build": "tsup && cp src/index.d.ts dist/index.d.ts && cp src/index.d.ts dist/index.d.cts",
    "lint": "eslint src/ test/ --fix",
    "push": "git push --follow-tags origin master && npm publish",
    "rls": "standard-version --release-as",
    "test": "npm run build && mocha --exit 'test/*.cjs' 'test/*.mjs'",
    "v": "node -e \"console.log(require('./package.json').version)\""
  },
  "author": "Nicolas Dao",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "co": "^4.6.0",
    "eslint": "^8.0.0",
    "mocha": "^10.2.0",
    "standard-version": "^9.3.1",
    "tsup": "^8.0.0",
    "typescript": "^6.0.2"
  }
}
